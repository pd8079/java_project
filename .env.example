DB_NAME=cyberops_arena
DB_USERNAME=cyberops
DB_PASSWORD=replace-with-a-long-random-db-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-root-password
JWT_SECRET=replace-this-with-at-least-32-random-characters-before-starting
JWT_EXPIRATION=1800
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:3000
