FROM docker.io/library/maven:3.9.11-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY pom.xml .
COPY src ./src
RUN mvn -B -DskipTests package

FROM docker.io/library/eclipse-temurin:21-jre AS java-runtime

FROM docker.io/library/mysql:8.4
WORKDIR /app
COPY --from=java-runtime /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="/opt/java/openjdk/bin:${PATH}"
COPY --from=build /workspace/target/cyberops-arena-0.1.0.jar /app/app.jar
COPY render-entrypoint.sh /app/render-entrypoint.sh
RUN chmod 0755 /app/render-entrypoint.sh
EXPOSE 10000
ENTRYPOINT ["/app/render-entrypoint.sh"]
